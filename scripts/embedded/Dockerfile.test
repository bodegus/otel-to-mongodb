# Runs the test suite on Linux, where the vendored pymongo-embedded wheel can be installed.
#
# Ubuntu 24.04 to match CI, and because the wheel is tagged manylinux_2_39: Debian bookworm
# carries glibc 2.36 and pip would reject the wheel there.
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /work

# Dependencies first, so editing app code does not re-resolve them.
COPY pyproject.toml uv.lock README.md ./
COPY vendor/ ./vendor/
RUN uv python install 3.12 \
    && uv sync --all-extras --frozen --no-install-project

COPY app/ ./app/
RUN uv sync --all-extras --frozen

ENTRYPOINT ["uv", "run", "--frozen", "pytest"]
CMD ["app/tests"]
